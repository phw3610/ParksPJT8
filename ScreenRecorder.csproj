<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ScreenRecorder</AssemblyName>
    <RootNamespace>ScreenRecorder</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Screen Recorder</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- Windows Graphics Capture (the "Windows capture" mode). Compile-time metadata only; the types come from the OS. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.4948" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- DXGI desktop capture. Embedded below so the program stays one exe. -->
    <PackageReference Include="SharpDX" Version="4.2.0" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgSharpDX)\lib\net45\SharpDX.dll" LogicalName="lib.SharpDX.dll" />
    <EmbeddedResource Include="$(PkgSharpDX_Direct3D11)\lib\net45\SharpDX.Direct3D11.dll" LogicalName="lib.SharpDX.Direct3D11.dll" />
    <EmbeddedResource Include="$(PkgSharpDX_DXGI)\lib\net45\SharpDX.DXGI.dll" LogicalName="lib.SharpDX.DXGI.dll" />
  </ItemGroup>
</Project>
